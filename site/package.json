{
  "name": "iaeg2026-soft-soil-egm-site",
  "description": "Amsterdam Noord BIM viewer and footprint map, adapted from the bimpolars demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anywidget/types": "^0.4.0",
    "@speckle/objectloader2": "^2.31.14",
    "@speckle/viewer": "^2.31.14",
    "3d-tiles-renderer": "^0.3.46",
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.2",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.22.0",
    "three": "0.140.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/three": "0.140.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  },
  "overrides": {
    "three": "$three",
    "@types/three": "$@types/three"
  }
}
